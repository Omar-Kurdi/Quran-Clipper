.vscode/
.idea/

FutureIdeas.md
existingwebsite/

# Python sidecar
asr-service/.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# stray file from a malformed pip install
asr-service/=*

# local-only Claude Code settings (settings.json is shared)
.claude/settings.local.json
.claude/launch.json

# model / corpus caches
*.nemo
.cache/

# Written by `next dev` (Next 16.3+ generates agent instruction files via
# node_modules/next/dist/server/lib/generate-agent-files.js). Deleting them
# does not stick -- they reappear on the next dev run -- so they are ignored
# rather than tracked. Remove these two lines if you would rather commit them.
/AGENTS.md
/CLAUDE.md

# Recitation clips used for evaluation. Kept out of the repo because they are
# large binaries that change often and belong to whoever is testing, not to the
# project. `scripts/eval_segments.py` and the sidecar both take an audio path,
# so point them at your own files -- see docs/ALIGNMENT.md.
*.mp3
*.wav
*.m4a
*.ogg
# A background clip for testing the export path keeps the same company.
*.mkv

# Where the studio's "Ground truth" button saves the recording a set of expected
# captions describes. The extensions above cover most of it; this covers the
# rest, because what lands here is whatever container the upload was in.
scripts/audio/

# The expected captions themselves, for the same reason the recordings are out:
# they belong to whoever is testing. A ground-truth file names the clip it was
# cut from -- often a video id -- and is only useful beside a recording that is
# not here anyway. Write your own from the studio's "Ground truth" button; see
# docs/ALIGNMENT.md.
scripts/expected_*.txt

# Pid files and logs from ./start.sh
.run/

# Quranic data held locally rather than committed: someone else's copyright in
# every case, and tens of megabytes besides.
#   data/quran/  The Clear Quran, from quranapi.pages.dev, until the Quran
#                Foundation grants access to their id 131.
#   data/qul/    Morphology and mutashabihat exports from qul.tarteel.ai, which
#                are downloaded from a signed-in account rather than fetched.
data/

# Skylos. baseline.portable.json and accepted.txt are committed: together they
# record the findings this repo already had, so the gate blocks on new problems
# rather than on debt it did not create.
#
# baseline.json is GENERATED from the portable copy on every run, and ignored.
# Skylos writes absolute paths into a baseline, which match only the checkout
# that produced them; the portable copy writes the repo root as {ROOT} so any
# checkout -- another machine, or CI -- can pin it to its own. The cache beside
# them is local scratch.
.skylos/cache/
.skylos/baseline.json
