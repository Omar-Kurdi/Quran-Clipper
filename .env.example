# Copy this file to .env.local and fill in only what you need.
# Nothing here is required — the app runs without any of it, and each variable
# just enables an optional capability.

# ---------------------------------------------------------------------------
# Alignment sidecar  (recommended — this is what times uploaded audio)
# ---------------------------------------------------------------------------
# The Python service in ./asr-service. See asr-service/README.md to set it up.
# No API key, no per-request cost, and audio never leaves your machine.
# ASR_SERVICE_URL=http://127.0.0.1:8000

# Which matcher /api/audio/match uses when the client doesn't pick one:
#
#   align  - RECOMMENDED ("Local" in the studio). Force-aligns known Quran text
#            against the audio, so a word cannot be dropped, garbled, or put in
#            the wrong surah. Needs the sidecar.
#   gemini - "Online" in the studio. Cloud only, zero setup. Timing is an
#            estimate, not a measurement.
#
# See docs/ALIGNMENT.md for the comparison.
# AUDIO_MATCH_PROVIDER=align

# ---------------------------------------------------------------------------
# Gemini  (needed only for the `gemini` matcher)
# ---------------------------------------------------------------------------
# Create a key at https://aistudio.google.com/apikey — the free tier is enough
# to try it. GOOGLE_API_KEY works as an alternative name.
# Inline audio is limited to roughly 18 MB (about 15-20 minutes of MP3).
# GEMINI_API_KEY=your_gemini_api_key_here

# Must be a current model that accepts audio input. Model IDs are retired
# regularly — gemini-2.0-flash and gemini-2.5-flash are already gone and return
# HTTP 404. Check https://ai.google.dev/gemini-api/docs/models before setting.
# (chirp_3 is a Speech-to-Text model, not a Gemini model, and will not work.)
# GEMINI_MODEL=gemini-3.6-flash

# Ceiling on a single Gemini request, in milliseconds.
# GEMINI_TIMEOUT_MS=180000

# ---------------------------------------------------------------------------
# Pexels  (optional — only for pasting Pexels *page* links as backgrounds)
# ---------------------------------------------------------------------------
# Free key at https://www.pexels.com/api/. With it, the background field accepts
# a page link copied straight from the address bar
# (https://www.pexels.com/video/...-34918472/) and resolves it to the video file.
# Without it, use the download menu on Pexels, copy the file link, and paste
# that instead — everything else works the same.
# PEXELS_API_KEY=your_pexels_api_key_here

# ---------------------------------------------------------------------------
# Database  (optional)
# ---------------------------------------------------------------------------
# Without this, saved projects and exports live in memory and are lost when the
# server restarts.
#
# IMPORTANT: leave this commented out unless you have a database running. The
# API checks whether the variable is SET, not whether it connects, so a
# placeholder value skips the in-memory fallback and makes every save return
# HTTP 500. See the "Database (optional)" section of README.md for setup.
# DATABASE_URL=postgres://quranclipper:quranclipper@127.0.0.1:5432/quranclipper
